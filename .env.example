# Copy to .env (`make setup` does) and replace both passwords. Use letters and digits
# only, because they also appear inside the URLs below: `openssl rand -hex 24` makes one.

POSTGRES_USER=ltd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ltd
# Ports on this machine for the two databases (inside Docker both listen on 5432).
POSTGRES_PORT=55432
POSTGRES_TEST_PORT=55433

# Used by the Python package and dbt when run on the host; same password as above.
DATABASE_URL=postgresql://ltd:change-me@localhost:55432/ltd
# The integration tests empty every table, so they get their own database (db_test).
TEST_DATABASE_URL=postgresql://ltd:change-me@localhost:55433/ltd

# Password for the read-only dashboard login; `make migrate` applies it.
READER_PASSWORD=change-me-too

# Server only: the site's names (the domain, then the same with www. in front), separated by
# a space, no quotes, once DNS points at the server. Caddy gets the HTTPS certificates
# itself. ":80" = plain HTTP on the server's IP address.
SITE_ADDRESS=:80

# Laptop only: your server, for `make deploy`, `make fetch-dump` and `make tunnel`
# (e.g. VPS_HOST=root@1.2.3.4), the project folder on it, and the local port `make tunnel` uses.
# VPS_HOST=
# VPS_DIR=/opt/eugene-bus-reliability
# TUNNEL_PORT=55439

# LTD feeds (public, no key). Verified live 2026-09.
GTFS_STATIC_URL=https://feed.ltd.org/TMGTFSRealTimeWebService/GTFS/google_transit.zip
GTFS_RT_TRIP_UPDATES_URL=https://feed.ltd.org/TMGTFSRealTimeWebService/TripUpdate/TripUpdates.pb
GTFS_RT_VEHICLE_POSITIONS_URL=https://feed.ltd.org/TMGTFSRealTimeWebService/Vehicle/VehiclePositions.pb
GTFS_RT_ALERTS_URL=https://feed.ltd.org/TMGTFSRealTimeWebService/Alert/Alerts.pb

# Poll interval in seconds. Polling faster than the feed updates only produces identical
# fetches, which the poller counts and discards (see rt.fetch_unchanged).
POLL_INTERVAL_SECONDS=30

# Where raw .pb.gz files are archived (replayable source of truth).
RAW_ARCHIVE_DIR=./data/raw

# Minutes between the scheduler's dbt builds (default 15).
# DBT_BUILD_EVERY_MINUTES=15